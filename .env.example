# ============================================================
# CONFIGURAÇÃO DO BOT DE OFERTAS - MERCADO LIVRE + SHOPEE
# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com dados reais) para o GitHub ou
# qualquer lugar público.
# ============================================================

# ---------- WhatsApp ----------
# JID do grupo existente (ex: 120363012345678901@g.us).
# Descubra rodando: npm run list-groups (depois de escanear o QR code)
WHATSAPP_GROUP_ID=

# ---------- Janela de funcionamento ----------
# Fuso horário usado para calcular a janela 8h-22h
TIMEZONE=America/Sao_Paulo
START_HOUR=8
END_HOUR=22
# Intervalo entre postagens, em minutos (padrão pedido: 15).
# Veja o README para uma discussão sobre risco de banimento com
# intervalos muito curtos.
POST_INTERVAL_MINUTES=60
# Máximo de mensagens por dia (proteção extra contra excesso/possível
# bloqueio pelo WhatsApp). Deixe vazio para não limitar.
MAX_POSTS_PER_DAY=14

# ---------- Mercado Livre ----------
# Método de geração do link de afiliado:
#   matt_word  -> usa os parâmetros matt_word/matt_tool (padrão do
#                 Portal de Afiliados do Mercado Livre)
#   simple_tag -> usa um parâmetro "tag" simples (alguns programas de
#                 afiliados/redes usam esse formato)
ML_LINK_MODE=matt_word
# Obtidos em https://www.mercadolivre.com.br/l/afiliados-portal-do-afiliado
# (seção "Meus links" / dados da sua conta de afiliado)
ML_MATT_WORD=
ML_MATT_TOOL=
ML_SIMPLE_TAG=
# OBRIGATÓRIO: credenciais de uma aplicação criada em
# developers.mercadolivre.com.br (App ID / Chave Secreta). O endpoint de
# busca do Mercado Livre exige autenticação OAuth. Depois de preencher,
# rode "node src/mlAuthSetup.js" uma vez (veja ML_OAUTH_SETUP.md).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser https:// (Mercado Livre não aceita http://localhost) e, pelo
# visto, também não aceita usar o próprio domínio deles como redirect —
# por isso usamos um domínio neutro reservado para testes (example.com).
ML_REDIRECT_URI=https://example.com
ML_TOKEN_FILE=./data/ml_token.json

# Palavras-chave/categorias usadas para buscar ofertas (separadas por vírgula).
# O bot busca cada termo na API pública do Mercado Livre e escolhe os
# produtos com maior percentual de desconto.
ML_SEARCH_TERMS=eletronicos,eletrodomesticos,celular,informatica,casa
# Site do Mercado Livre (MLB = Brasil)
ML_SITE_ID=MLB
# Desconto mínimo (%) para um produto ser considerado "oferta"
ML_MIN_DISCOUNT_PERCENT=20

# ---------- Shopee ----------
# Credenciais do Shopee Affiliate Open Platform
# (cadastro em https://affiliate.shopee.com.br -> "Open API")
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_GRAPHQL_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_SEARCH_TERMS=eletronicos,casa,beleza,celular,moda
SHOPEE_MIN_DISCOUNT_PERCENT=20

# ---------- Cupons manuais (opcional) ----------
# Caso queira forçar um cupom fixo quando a API não trouxer um cupom
# específico para o produto, defina abaixo (ficará em branco/omitido
# na mensagem se não houver cupom).
ML_FALLBACK_COUPON=
SHOPEE_FALLBACK_COUPON=

# ---------- Diversos ----------
# Pasta onde o bot guarda a sessão do WhatsApp (para não precisar
# escanear o QR code toda vez que reiniciar)
SESSION_DIR=./data/auth
# Arquivo que guarda quais produtos já foram postados hoje (evita repetição)
POSTED_LOG_FILE=./data/posted.json
LOG_LEVEL=info
